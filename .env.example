# Copy file này thành .env.local rồi điền giá trị lấy ở Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) hoặc "anon public" key — loại này được phép công khai
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...) hoặc "service_role" key — CHỈ dùng cho "npm run upload" trên máy bạn.
# TUYỆT ĐỐI không đưa lên Vercel, không chia sẻ cho ai.
SUPABASE_SERVICE_ROLE_KEY=

# --- Giai đoạn 2: AI chấm Writing/Speaking (chỉ dùng ở server, KHÔNG có tiền tố NEXT_PUBLIC_) ---
# Chọn nhà cung cấp: gemini (mặc định) | groq | ollama (chỉ chạy được trên máy bạn, không dùng trên Vercel)
AI_PROVIDER=gemini
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Nếu dùng Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Tuỳ chọn: đổi model (mặc định gemini-2.5-flash / llama-3.3-70b-versatile / llama3.1)
AI_MODEL=
# Tuỳ chọn: địa chỉ Ollama (mặc định http://localhost:11434)
OLLAMA_URL=
